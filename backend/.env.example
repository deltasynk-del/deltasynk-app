# Homebrew PostgreSQL (same server as QualitySchool / SynkMart — port 5433):
DATABASE_URL="postgresql://YOUR_MAC_USERNAME@localhost:5433/deltasynk_portal?schema=public"
# Docker Compose alternative (port 5435):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5435/deltasynk_portal?schema=public"

JWT_SECRET="change-me-in-production-use-long-random-string"
# Portal sessions are short on purpose — this system approves money and sender IDs.
JWT_EXPIRES_IN="12h"
# Encrypts stored TOTP secrets and the platform keys of connected apps. Falls back
# to JWT_SECRET when unset. Changing it later makes those stored values unreadable.
DATA_ENCRYPTION_KEY=""

PORT=3030
CORS_ORIGIN="http://localhost:4220"
APP_URL="http://localhost:4220"

# First owner account, created by `npm run db:seed` (only when no owner exists).
# The owner is asked to choose a new password on first sign-in.
SEED_OWNER_NAME="Portal Owner"
SEED_OWNER_EMAIL="owner@deltasynk.com"
SEED_OWNER_PHONE=""
SEED_OWNER_PASSWORD=""

# Email (SMTP) — password reset links and email 2FA codes
MAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME="DeltaSynk Portal"
# When SMTP/SMS is not configured, codes and links are returned in API responses (development only)
MAIL_EXPOSE_DEV_LINKS=true

# SMS — Onfon Media (SMS 2FA codes)
ONFON_API_KEY=
ONFON_CLIENT_ID=
ONFON_BASE_URL=https://api.onfonmedia.co.ke
ONFON_SENDER_ID=

# Printed warranty cards: the SynkMart page each card's QR code opens (the card number is added).
WARRANTY_CARD_URL=https://synkmart.deltasynk.com/w/
